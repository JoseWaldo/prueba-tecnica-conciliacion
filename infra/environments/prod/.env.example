# Copia este archivo como `.env` (en el mismo directorio, infra/environments/prod)
# y rellena tus credenciales reales.
#
# `.env` NO se hace commit (ver infra/.gitignore).

AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1

# Solo para credenciales temporales (descomentar si aplica):
# AWS_SESSION_TOKEN=...
